{
  "name": "kakeibo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test:parse && npm run security:audit:prod && vite build",
    "cf:dev": "vite build && wrangler pages dev dist",
    "test:parse": "node --test scripts/*.test.js",
    "security:audit": "npm audit --audit-level=high",
    "security:audit:prod": "npm audit --omit=dev --audit-level=high",
    "verify:release": "npm run build",
    "deploy:nav": "wrangler deploy --config wrangler.nav.toml"
  },
  "dependencies": {
    "tesseract.js": "^5.1.0",
    "vue": "^3.4.38"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.153.0"
  }
}
